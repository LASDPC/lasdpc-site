# Copie este arquivo para .env e ajuste os valores
#
# Em desenvolvimento deixe vazio - o proxy do Vite encaminha /api para o backend
# Em produção mantenha vazio se o Nginx encaminha /api na mesma origem HTTPS.
VITE_API_URL=

# Porta do backend usada pelo proxy do Vite em desenvolvimento (padrão: 8000)
VITE_BACKEND_PORT=8000

# Prefixo público das imagens, sem o nome do bucket. O padrão /media usa o proxy
# do Vite em desenvolvimento e o Nginx em produção. Pode ser uma URL HTTPS.
VITE_MINIO_PUBLIC_URL=/media
